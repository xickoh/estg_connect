{
    "compilerOptions": {
        "target": "es5",
        "module": "commonjs",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "jsx": "react",
        "resolveJsonModule": true,
        "paths": {
            "@public/*": [
                "./public/*"
            ]
        },
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "@public/**/*",
    ]
}